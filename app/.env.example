# Copy to .env and fill in. In Coolify, set these in the resource's
# Environment Variables instead (do NOT commit real secrets).

# ---- App ----
PORT=3000
NODE_ENV=production
# Set true when served over HTTPS (Coolify). false for local http dev.
COOKIE_SECURE=true
# REQUIRED: long random string used to sign session JWTs (>= 16 chars).
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# ---- Database ----
# Compose builds DATABASE_URL from these; the db service uses them too.
POSTGRES_USER=mrc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mrc
# For non-compose deploys you can instead point straight at a DB:
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ---- NabuGate (internal model gateway) ----
# The address + port of your NabuGate instance. Leave empty to fall back to
# ANTHROPIC_API_KEY (or to the UI's preview message if neither is set).
NABUGATE_URL=http://nabugate:8080
NABUGATE_API_KEY=nabu_dev_key_change_me
NABUGATE_MODEL=nabu-fast
# LLM_MAX_TOKENS=1500

# Optional direct Anthropic fallback (used only when NABUGATE_URL is empty).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Billing ----
# manual = checkout activates immediately (demo). Plug a real gateway later.
BILLING_PROVIDER=manual

# Host port to publish the app on for plain `docker compose up`.
APP_PORT=3000
